<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    app:cardBackgroundColor="@color/activity_card_bg"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/card_padding"

    android:layout_marginBottom="@dimen/margin_bottom_3"

    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_item_activity_index"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/main_text"
            android:textSize="@dimen/subtitle_text_size_1"
            android:text="@string/one" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginEnd="@dimen/side_margin_1"
            android:layout_marginStart="@dimen/side_margin_1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_item_activity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/main_text"
                android:text="@string/empty_duration"
                android:textSize="@dimen/subtitle_text_size_2"
                android:textStyle="bold"

                />

            <TextView
                android:id="@+id/text_item_activity_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secondary_text"
                android:text="@string/empty"
                android:textSize="@dimen/body_text_size_2" />

            <TextView
                android:id="@+id/text_item_activity_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:textColor="@color/secondary_text"
                android:text="@string/empty"
                android:textSize="@dimen/body_text_size_2"
                android:layout_marginBottom="@dimen/margin_bottom_5"
                />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_item_activity_new_shake_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_bottom_5"
                android:visibility="gone"
                app:cardBackgroundColor="@color/record_bg"
                app:cardCornerRadius="@dimen/record_radius"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/record_padding">

                <TextView
                    android:id="@+id/text_item_activity_new_shake_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_shake_record"
                    android:textColor="@color/record_text"
                    android:textSize="@dimen/body_text_size_2"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_item_activity_new_step_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/record_bg"
                app:cardCornerRadius="@dimen/record_radius"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/record_padding"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/text_item_activity_new_step_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_step_record"
                    android:textColor="@color/record_text"
                    android:textSize="@dimen/body_text_size_2"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/textView22"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/subtitle_text_size_1"
            android:text="@string/icon_more" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/main_margin"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textColor="@color/main_text"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_info"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="@dimen/group_margin_bottom"
                />


            <androidx.cardview.widget.CardView
                android:id="@+id/currentSessionGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/card_padding"

                android:layout_marginBottom="@dimen/group_margin_bottom"
                >


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_bottom_3"
                        >

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:text="@string/current_session"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/subtitle_text_size_1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/duration_color"
                            android:textStyle="bold"
                            android:textSize="@dimen/subtitle_text_size_1"
                            android:text="@string/empty_duration"
                            android:gravity="end"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/currentInfo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_bottom_4"
                        android:baselineAligned="false"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:id="@+id/textView4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/steps"
                                android:textSize="@dimen/body_text_size_1"

                                android:gravity="center"
                                android:textColor="@color/steps_color"
                                android:textStyle="bold"
                                />

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty"
                                android:textSize="@dimen/body_text_size_1"
                                android:gravity="center"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/shakes"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/shakes_color"
                                android:textStyle="bold"
                                />

                            <TextView
                                android:id="@+id/textView7"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty"
                                android:textSize="@dimen/body_text_size_1"
                                android:gravity="center"
                                />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/currentSummary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_bottom_3"
                        android:baselineAligned="false"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView9"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/duration"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/secondary_text"
                                />

                            <TextView
                                android:id="@+id/textView10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/duration_color"

                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/steps_per_min"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/secondary_text"
                                />

                            <TextView
                                android:id="@+id/textView12"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/steps_color"

                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView13"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/shakes_per_min"
                                android:gravity="center"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/secondary_text"
                                />

                            <TextView
                                android:id="@+id/textView14"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/empty"
                                android:textSize="@dimen/body_text_size_1"
                                android:textColor="@color/shakes_color"
                                />
                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/subtitle_text_size_2"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary_light"
                        android:text="@string/save_session" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/totalHistoryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/card_padding"

                android:layout_marginBottom="@dimen/group_margin_bottom"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:id="@+id/textView15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/total_from_history"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/subtitle_text_size_1"
                        android:layout_marginBottom="@dimen/margin_bottom_3"
                        android:textStyle="bold"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_bottom_4">

                        <TextView
                            android:id="@+id/textView17"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/empty_steps"
                            android:textColor="@color/secondary_text"
                            android:gravity="center"
                            android:textSize="@dimen/body_text_size_1"
                            />

                        <TextView
                            android:id="@+id/textView16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/empty_shakes"
                            android:textColor="@color/secondary_text"
                            android:gravity="center"
                            android:textSize="@dimen/body_text_size_1"
                            />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/historyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/card_padding"

                android:layout_marginBottom="@dimen/group_margin_bottom"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/session_history"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/subtitle_text_size_1"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/margin_bottom_3"
                        />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_activity">


                    </androidx.recyclerview.widget.RecyclerView>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/secondary_text"
                        android:layout_marginBottom="@dimen/margin_bottom_3"

                        android:text="@string/empty_history" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</android.widget.LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/main_margin"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/main_text"
            android:textSize="@dimen/title_text_size"
            android:layout_marginTop="@dimen/margin_bottom_3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_margin_bottom"
            android:text="@string/title_info"
            android:textColor="@color/secondary_text" />


        <androidx.cardview.widget.CardView
            android:id="@+id/currentSessionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="@dimen/group_margin_bottom"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"

            app:contentPadding="@dimen/card_padding">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_bottom_3"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"

                        android:text="@string/current_session"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/subtitle_text_size_1"
                        android:textStyle="bold" />

                    <!--                        <TextView-->
                    <!--                            android:id="@+id/textView20"-->
                    <!--                            android:layout_width="match_parent"-->
                    <!--                            android:layout_height="wrap_content"-->
                    <!--                            android:layout_weight="1"-->
                    <!--                            android:gravity="end"-->
                    <!--                            android:text="@string/empty_duration"-->
                    <!--                            android:textColor="@color/duration_color"-->
                    <!--                            android:textSize="@dimen/subtitle_text_size_1"-->
                    <!--                            android:textStyle="bold"-->
                    <!--                            tools:visibility="gone" />-->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/currentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/margin_bottom_4"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/steps"

                            android:textColor="@color/steps_color"
                            android:textSize="@dimen/body_text_size_1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_current_steps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/empty"
                            android:textSize="@dimen/body_text_size_1" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/shakes"
                            android:textColor="@color/shakes_color"
                            android:textSize="@dimen/body_text_size_1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_current_shakes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/empty"
                            android:textSize="@dimen/body_text_size_1" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/currentSummary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/margin_bottom_3"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/duration"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/body_text_size_1" />

                        <TextView
                            android:id="@+id/text_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/empty"
                            android:textColor="@color/duration_color"
                            android:textSize="@dimen/body_text_size_1"

                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView11"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/steps_per_min"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/body_text_size_1" />

                        <TextView
                            android:id="@+id/text_steps_per_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/empty"
                            android:textColor="@color/steps_color"
                            android:textSize="@dimen/body_text_size_1"

                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView13"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/shakes_per_min"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/body_text_size_1" />

                        <TextView
                            android:id="@+id/text_shakes_per_min"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/empty"
                            android:textColor="@color/shakes_color"
                            android:textSize="@dimen/body_text_size_1" />
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/button_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary_light"
                    android:text="@string/save_session"
                    android:textColor="@color/white"
                    android:textSize="@dimen/subtitle_text_size_2" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/totalHistoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="@dimen/group_margin_bottom"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"

            app:contentPadding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_bottom_3"
                    android:text="@string/total_from_history"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/subtitle_text_size_1"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/margin_bottom_4"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_total_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/empty_steps"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/body_text_size_1" />

                    <TextView
                        android:id="@+id/text_total_shakes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/empty_shakes"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/body_text_size_1" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/historyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="@dimen/group_margin_bottom"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"

            app:contentPadding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_bottom_3"
                    android:text="@string/session_history"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/subtitle_text_size_1"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_activity">


                </androidx.recyclerview.widget.RecyclerView>

                <TextView
                    android:id="@+id/text_no_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_bottom_3"
                    android:gravity="center"
                    android:text="@string/empty_history"

                    android:textColor="@color/secondary_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</android.widget.LinearLayout>